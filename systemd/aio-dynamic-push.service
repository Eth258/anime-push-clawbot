[Unit]
Description=aio-dynamic-push (Bilibili dynamic monitor -> WeChat)
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aio-dynamic-push
ExecStart=/opt/aio-dynamic-push/.venv/bin/python main.py
Restart=always
RestartSec=15
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
